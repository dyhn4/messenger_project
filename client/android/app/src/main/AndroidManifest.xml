<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 큰 첨부를 받기 전에 Wi-Fi인지 휴대폰 데이터인지 보려고(데이터 사용 경고 — MainActivity의
         tangotalk/network 채널). 설치 때 자동으로 주어지는 권한이라 요청 창은 뜨지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 앱 업데이트를 "다운로드 후 바로 설치" 흐름으로 처리하려고(브라우저로 넘기지 않고
         다운로드한 apk를 앱이 직접 패키지 설치 화면으로 넘김) 필요하다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 화상회의(LiveKit/WebRTC). 실제 권한 요청 창은 통화를 시작할 때 flutter_webrtc가
         띄우므로 여기서는 선언만 한다. 카메라가 없는 기기(태블릿 일부)에서도 설치는 되도록
         uses-feature는 required="false"로 둔다 — 마이크만으로도 통화에 참여할 수 있다. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- 걸려온 화상회의를 잠금화면 위에 전체화면으로 띄우기 위한 권한(Android 14+에서
         통화/알람 앱에만 허용된다 — 우리는 category=call 알림에만 쓴다). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 통화 중에만 도는 포그라운드 서비스 — 이게 없으면 통화 중 홈으로 나가는 순간 OS가
         카메라/마이크 캡처를 끊는다(Android 14+). 알림바의 "통화 중" 표시가 이 서비스다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 화면 공유(MediaProjection) — 공유를 켤 때만 이 타입으로 서비스를 다시 띄운다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 다운로드한 첨부를 공용 Download/TangoTalk에 바로 저장한다. 안드로이드 11부터는 권한 없이도
         되고, 10 이하에서만 이 권한이 필요하다(요청은 저장할 때 MainActivity.kt가 한다).
         안드로이드 10은 아래 requestLegacyExternalStorage까지 있어야 파일 경로로 쓸 수 있다. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <application
        android:label="TangoTalk"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 초대 링크(tangotalk://pair?...)로 앱을 열어 서버 주소/코드를 자동입력하기 위한
                 커스텀 스킴. http(s) App Links와 달리 도메인 소유 확인이 필요 없어 고정
                 도메인이 없는 이 서버 구조에 적합하다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tangotalk"/>
            </intent-filter>
            <!-- 다른 앱(갤러리·파일·브라우저 등)의 "공유 → TangoTalk" — 글·파일 하나/여러 개. 받은 것은 MainActivity.kt가
                 앱으로 넘기고, 앱이 보낼 대화방을 고르게 한다(share_intake.dart). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- 홈 화면 위젯 "안 읽은 대화"(UnreadWidgetProvider.kt — 내용은 앱이 넘긴다). -->
        <receiver
            android:name=".UnreadWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unread_widget_info"/>
        </receiver>
        <!-- flutter_foreground_task의 서비스(이름은 바꾸면 안 됨). stopWithTask=true라
             최근 앱에서 앱을 밀어 없애면 통화 서비스도 같이 끝난다. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="camera|microphone|mediaProjection"
            android:stopWithTask="true"
            android:exported="false" />
        <!-- 상태 표시줄 알림 아이콘(흰 말풍선 실루엣). 앱 아이콘(@mipmap/ic_launcher)은 8.0+에서
             적응형 아이콘이라 알림 아이콘으로 쓰면 안 된다(8.0에서 시스템 UI가 죽는 버그, 그 밖에는
             흰 네모로만 보임). 앱이 꺼져 있을 때 FCM이 직접 그리는 알림과, 통화 중 포그라운드
             서비스 알림(call_controller.dart의 NotificationIcon)이 이 값을 쓴다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.teamtalk.messenger.NOTIFICATION_ICON"
            android:resource="@drawable/ic_notification" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
