<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 디버그(개발 기기에 직접 설치) 빌드 — 개발용 APNs. 배포 빌드는 Runner.entitlements. -->
	<!-- 앱이 꺼져 있을 때의 푸시(APNs — FCM이 보낸다). App ID에 Push Notifications를 켜야 프로비저닝 프로파일에 들어간다. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- 화면 공유 방송 확장(BroadcastExtension)과 같이 쓰는 앱 그룹 — Info.plist의 RTCAppGroupIdentifier와 같다. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.teamtalk.messenger</string>
	</array>
</dict>
</plist>
