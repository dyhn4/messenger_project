# 이 파일을 .env로 복사하고 값을 채우면 서버가 읽어갑니다(dotenv).
# 둘 다 비워두면 서버가 처음 실행될 때 안전한 무작위 값을 만들어서
# .jwt-secret / .db-encryption-key 파일에 저장해두고 계속 재사용합니다 —
# 그래서 .env 없이도 바로 실행은 되지만, 여러 서버 인스턴스를 두거나
# DB를 옮길 계획이 있다면 여기서 직접 값을 정해서 고정해두는 걸 권장합니다.

# PostgreSQL 접속 문자열. 이건 자동 생성이 안 되니 반드시 직접 채워야 합니다.
# 예: postgres://messenger_app:비밀번호@localhost:5432/messenger
DATABASE_URL=

# JWT(AccessToken/RefreshToken) 서명용 비밀키.
# JWT_SECRET=

# DB에 저장하는 이메일 등 민감 필드 암호화 키. 반드시 32바이트(64자리 hex)여야 합니다.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DB_ENCRYPTION_KEY=

# PORT=3000
