# 이 파일을 .env로 복사하고 값을 채우면 서버가 읽어갑니다(dotenv).
# 둘 다 비워두면 서버가 처음 실행될 때 안전한 무작위 값을 만들어서
# .jwt-secret / .db-encryption-key 파일에 저장해두고 계속 재사용합니다 —
# 그래서 .env 없이도 바로 실행은 되지만, 여러 서버 인스턴스를 두거나
# DB를 옮길 계획이 있다면 여기서 직접 값을 정해서 고정해두는 걸 권장합니다.

# PostgreSQL 접속 문자열. 이건 자동 생성이 안 되니 반드시 직접 채워야 합니다.
# 예: postgres://messenger_app:비밀번호@localhost:5432/messenger
DATABASE_URL=

# JWT(AccessToken/RefreshToken) 서명용 비밀키.
# JWT_SECRET=

# DB에 저장하는 이메일 등 민감 필드 암호화 키. 반드시 32바이트(64자리 hex)여야 합니다.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DB_ENCRYPTION_KEY=

# PORT=3000

# 새 기기 페어링 부트스트랩 서버 포트(pairing.js). 기본값은 PORT+1.
# PAIRING_PORT=3001

# 사내망 밖(LTE/5G)에서 접속할 주소 — DDNS 도메인(예: xxx.iptime.org) 또는 고정 공인 IP.
# 공유기에서 이 포트(기본 PORT, 다르면 "주소:포트")를 이 PC의 PORT로 포워딩해야 합니다.
# 화상회의도 쓰려면 UDP 50000-60000과 TCP 7881(livekit.yaml의 rtc 포트)도 같은 번호로
# 포워딩하세요 — 서버가 livekit.yaml에 공인 IP를 넣어줍니다.
# 초대 링크 안내 페이지를 밖에서도 열려면 페어링 포트(PAIRING_PORT)도 같은 번호로 포워딩하세요 —
# 평문 HTTP라 밖에서는 안내 페이지·설치 파일·도움말만 열리고 페어링은 막힙니다(밖에서는 PORT로 페어링).
# 처음 넣거나 바꾸면 서버가 이 주소를 넣어 TLS 인증서를 새로 만듭니다 — 그러면 이미 연결한
# 모든 클라이언트가 페어링 코드로 다시 연결해야 합니다(밖에서는 외부 주소로 재페어링). 앱은
# 접속할 때 이 주소를 받아 저장해두고, 사내 주소로 연결이 안 되면 자동으로 이 주소로 전환합니다.
# EXTERNAL_ADDRESS=

# ── 아이폰용 웹 앱 주소(공인 인증서) ──
# 아이폰 등 앱을 설치할 수 없는 기기는 브라우저(Safari)로 웹 앱을 씁니다. Safari는 공인 인증서가 있어야 웹 앱(홈 화면 추가·알림
# 포함)을 제대로 열 수 있어서, 도메인을 적으면 서버가 웹 앱 전용 HTTPS 포트를 하나 더 열고 그 도메인의 Let's Encrypt 인증서를
# 자동으로 받아 겁니다(90일짜리, 만료 30일 전부터 자동 갱신, 재시작 필요 없음). PC·안드로이드 앱은 지금처럼 PORT를 씁니다.
# 비워 두면 이 기능은 꺼지고 지금과 똑같이 동작합니다(포트를 더 열지 않고 인증서도 받지 않음).
# 도메인 이름만 적으세요(https://·포트 없이). EXTERNAL_ADDRESS와 같은 DDNS 이름(예: xxx.iptime.org)이어도 됩니다.
# 공유기 포트포워딩(TCP): 외부 443 → 이 PC의 WEB_HTTPS_PORT, 외부 80 → 이 PC의 ACME_HTTP_PORT. Windows 방화벽도 열어야 합니다.
# 주의: iptime.org 같은 DDNS 도메인은 Let's Encrypt의 "등록 도메인당 7일에 새 인증서 50장" 한도를 그 DDNS를 쓰는 모든 사람이
# 함께 써서, 첫 발급이 한도에 걸릴 수 있습니다(한 번 받은 뒤의 갱신은 괜찮음). 그러면 서버가 알려 준 시각에 자동으로 다시 시도하고,
# 계속 막히면 직접 산 도메인을 CNAME으로 이 DDNS 이름에 연결해 그 도메인을 적으세요. 상태는 관리자 콘솔(웹 인증서)과 서버 로그에서
# 볼 수 있습니다. 인증서·계정 키·시도 기록은 certs/의 web.crt·web.key·acme-account.key·acme-state.json에 저장됩니다.
# 값을 넣으면 Let's Encrypt 가입자 약관(https://letsencrypt.org/repository/)에 동의한 것으로 보고 계정을 만듭니다.
# WEB_DOMAIN=

# 웹 앱 전용 HTTPS 포트(기본 443). 443이 아니면 주소가 https://도메인:포트가 되고, 인증서 확인(TLS-ALPN-01)에는 공유기에서
# 외부 443 → 이 포트 포워딩이 따로 필요합니다(HTTP-01이 되면 없어도 됨). PORT·PAIRING_PORT와 겹치면 안 됩니다.
# WEB_HTTPS_PORT=443

# 인증서 확인(HTTP-01)용 평문 HTTP 포트(기본 80). Let's Encrypt는 외부 80으로만 확인하므로 공유기에서 외부 80 → 이 포트로
# 포워딩합니다. 그 밖의 http:// 요청은 https://WEB_DOMAIN으로 보냅니다. 0이면 열지 않고 TLS-ALPN-01(외부 443)로만 확인합니다
# (통신사가 80을 막거나 IIS 등이 80을 쓰고 있을 때). 80/443을 다른 프로그램이 쓰고 있으면 로그에 알리고 10분마다 다시 시도합니다.
# ACME_HTTP_PORT=80

# (선택) Let's Encrypt 계정 연락처 이메일. 비워도 됩니다.
# ACME_EMAIL=

# 1이면 Let's Encrypt 시험용(staging) 인증서를 받습니다 — 브라우저는 신뢰하지 않지만 발급 한도 걱정 없이 포트포워딩이 맞는지
# 확인할 수 있습니다. 확인되면 지우고(또는 0) 서버를 다시 시작하면 정식 인증서를 받습니다.
# ACME_STAGING=1

# 첨부파일 저장 위치. 기본값은 서버 폴더 밑 uploads/. 다른 PC의 공유 폴더에 저장하려면
# UNC 경로나 매핑된 네트워크 드라이브를 지정하세요(그 경로가 항상 접근 가능해야
# 업로드/다운로드가 됩니다).
# 예: UPLOADS_DIR=\\192.168.0.50\share\messenger_uploads
# 예: UPLOADS_DIR=Z:\messenger_uploads
# UPLOADS_DIR=

# 한 사람이 하루에 올릴 수 있는 파일 용량(GB, 기본 10). 계정 하나가 디스크를 가득 채우는 걸 막는다.
# UPLOAD_DAILY_LIMIT_GB=10

# 할 일의 폴더 경로(파일 다운로드·업로드 폴더)로 더 허용할 사내 서버 이름, 쉼표로 구분. 사설 IP(\\192.168.0.5\…)와
# 점 없는 컴퓨터 이름(\\NAS\…)은 없어도 되고, 점이 든 이름(AD/DFS 도메인)이나 한글 이름의 사내 서버를 쓸 때만 넣는다.
# 정확한 이름만(와일드카드 없음, 대소문자 무시). IP 주소는 이 목록과 상관없이 사내망 대역만 받는다. 바꾼 뒤에는 서버 재시작.
# 예: TODO_FOLDER_HOSTS=nas.corp.local,corp.example.com
# TODO_FOLDER_HOSTS=
