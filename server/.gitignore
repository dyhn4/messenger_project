node_modules/
db.json
backup_before_reset_*/
backup_before_full_reset_*/
uploads/*
!uploads/.gitkeep
releases/*
!releases/.gitkeep
*.log

# 자동 생성되는 비밀값/인증서 — 절대 커밋하지 않는다 (config.js가 없으면 새로 만듦).
.env
.jwt-secret
.db-encryption-key
certs/

# 화상회의(LiveKit) — API 비밀값과, 개발용으로 내려받은 LiveKit 서버 실행 파일/설정.
# 운영 서버에서는 설치 프로그램이 같은 값을 livekit.yaml과 .env에 함께 심는다.
.livekit-secret
.livekit/

# FCM 푸시 발송용 Firebase 서비스 계정 키 — Admin 권한이라 절대 커밋하지 않는다.
firebase-service-account.json

# 서버+DB 설치 프로그램 빌드 산출물 — build_server_installer.ps1이 매번 새로 받고/만든다
# (Node 포터블 런타임, PostgreSQL 설치 프로그램, nssm.exe, npm install된 스테이징 node_modules,
# 컴파일된 설치 프로그램 exe). 소스(.iss/.ps1)만 커밋한다.
installer/bin/
installer/stage/
installer/output/

# 운영 중인 서버를 git 없이 업데이트하기 위한 코드 패키지(zip) 산출물 —
# package_server_update.ps1이 매번 새로 만든다.
deploy/stage/
deploy/output/

# 웹 앱 빌드 결과물(client/build/web을 복사해 넣는다 — config.js의 WEB_DIR).
web/

# 웹 푸시(VAPID) 키 — webPush.js가 처음 실행될 때 만든다. 바뀌면 브라우저 구독이 전부 무효가 된다.
.web-push-vapid.json

# 서버 전체 백업(src/backup.js) — 개발 PC에서는 server/backups에 쌓인다(설치본은 설치 폴더의 backups). 암호화돼 있어도
# DB 전체가 들어 있으니 커밋·배포하지 않는다(build_server_installer.ps1·package_server_update.ps1도 뺀다).
backups/
