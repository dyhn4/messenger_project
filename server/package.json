{
  "name": "messenger-server",
  "version": "1.0.0",
  "description": "메신저 앱 백엔드 - 인증, 실시간 채팅(Socket.io), 파일 업로드",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
