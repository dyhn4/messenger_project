    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "firebase-admin": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
